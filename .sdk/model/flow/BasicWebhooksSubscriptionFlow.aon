  step: [
    {
      input: {
        ref: "webhooks_subscription_ref01"
      }

      match: {
        app_id: "app01"
      }

      op: "create"
    }

    {
      data: {
        app_id: "app01"
      }

      input: {
        ref: "webhooks_subscription_ref01",
        srcdatavar: "webhooks_subscription_ref01_data",
        suffix: "_up0",
        textfield: "createdAt"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-webhooks_subscription_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "webhooks_subscription_ref01",
        srcdatavar: "webhooks_subscription_ref01_data",
        suffix: "_dt0"
      }

      match: {
        app_id: "app01",
        id: "webhooks_subscription01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-webhooks_subscription_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicWebhooksSubscriptionFlow"
}